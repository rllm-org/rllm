# Copy to ~/.rllm/terminal-rl-auto.env and chmod 600.
# The supervisor/sweep source this; nothing secret lives in the systemd unit.

# Fireworks key for the account that owns the trainer jobs.
# Must match TERMINAL_RL_ACCOUNT below.
export FIREWORKS_API_KEY='fw_xxxxxxxxxxxxxxxxxxxxxxxx'

# Fireworks account slug used for job cleanup API calls.
export TERMINAL_RL_ACCOUNT=research

# Modal workspace. Pin it explicitly: `modal profile activate` changes a global
# default, and an unattended supervisor would silently follow it to the wrong
# account.
export MODAL_PROFILE=fireworks-ai

# How remote sandboxes reach the local gateway.
#   public : bind the gateway on a routable IP:port (preferred on a server --
#            no quick-tunnel expiry, no DNS-blocklist exposure)
#   cloudflared : spawn a trycloudflare quick tunnel (laptop fallback)
export TERMINAL_RL_GATEWAY_MODE=public
export TERMINAL_RL_PUBLIC_URL='http://203.0.113.10:19090'
export TERMINAL_RL_GATEWAY_PORT=19090
